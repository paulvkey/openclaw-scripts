{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "models": {
        "deepseek/deepseek-v4-flash": {
          "alias": "DeepSeek V4 Flash"
        },
        "deepseek/deepseek-v4-flash-vision-exp": {
          "alias": "DeepSeek V4 Flash Vision"
        },
        "deepseek/deepseek-v4-pro": {
          "alias": "DeepSeek V4 Pro"
        },
        "foursapi-anthropic/claude-opus-4-8": {
          "alias": "Claude-Opus-4.8"
        },
        "foursapi-openai/gpt-5.6-sol": {
          "alias": "GPT-5.6-Sol"
        }
      },
      "model": {
        "primary": "deepseek/deepseek-v4-flash"
      },
      "contextInjection": "always",
      "bootstrapMaxChars": 20000,
      "bootstrapTotalMaxChars": 500000,
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "15m",
        "hardClearRatio": 0.5
      },
      "subagents": {
        "maxConcurrent": 8,
        "archiveAfterMinutes": 360
      },
      "sandbox": {
        "mode": "off"
      },
      "contextTokens": 1000000
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "gateway_env",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": false
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "reset": {
      "mode": "daily",
      "atHour": 4
    },
    "resetByType": {
      "direct": {
        "mode": "idle",
        "idleMinutes": 999999
      },
      "group": {
        "mode": "idle",
        "idleMinutes": 4320
      }
    }
  },
  "tools": {
    "profile": "coding"
  },
  "acp": {
    "enabled": true,
    "dispatch": {
      "enabled": true
    },
    "backend": "acpx",
    "defaultAgent": "codex",
    "allowedAgents": [
      "codex",
      "claude"
    ],
    "maxConcurrentSessions": 4,
    "runtime": {
      "ttlMinutes": 720
    }
  },
  "plugins": {
    "entries": {
      "deepseek": {
        "enabled": true
      },
      "browser": {
        "enabled": true
      },
      "tavily": {
        "enabled": true
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "apiKey": {
          "source": "env",
          "provider": "deepseek_env",
          "id": "DEEPSEEK_API_KEY"
        },
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0.14,
              "output": 0.28,
              "cacheRead": 0.028,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "compat": {
              "supportsReasoningEffort": true,
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            },
            "api": "openai-completions"
          },
          {
            "id": "deepseek-v4-flash-vision-exp",
            "name": "DeepSeek V4 Flash Vision",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0.14,
              "output": 0.28,
              "cacheRead": 0.028,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "compat": {
              "supportsReasoningEffort": true,
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            },
            "api": "openai-completions"
          },
          {
            "id": "deepseek-v4-pro",
            "name": "DeepSeek V4 Pro",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 1.74,
              "output": 3.48,
              "cacheRead": 0.145,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "compat": {
              "supportsReasoningEffort": true,
              "supportsUsageInStreaming": true,
              "maxTokensField": "max_tokens"
            },
            "api": "openai-completions"
          }
        ]
      },
      "foursapi-anthropic": {
        "baseUrl": "https://4sapi.com/v1",
        "apiKey": {
          "source": "env",
          "provider": "foursapi_anthropic_env",
          "id": "FOURSAPI_ANTHROPIC_API_KEY"
        },
        "api": "anthropic-messages",
        "models": [
          {
            "id": "claude-opus-4-8",
            "name": "Claude Opus 4.8",
            "api": "anthropic-messages",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 15,
              "output": 75,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 128000,
            "compat": {
              "supportsReasoningEffort": true,
              "maxTokensField": "max_tokens"
            }
          }
        ]
      },
      "foursapi-openai": {
        "baseUrl": "https://4sapi.com/v1",
        "apiKey": {
          "source": "env",
          "provider": "foursapi_openai_env",
          "id": "FOURSAPI_OPENAI_API_KEY"
        },
        "api": "openai-completions",
        "models": [
          {
            "id": "gpt-5.6-sol",
            "name": "GPT-5.6-Sol",
            "api": "openai-completions",
            "contextWindow": 1000000,
            "maxTokens": 128000,
            "compat": {
              "supportsReasoningEffort": true,
              "maxTokensField": "max_tokens"
            },
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 5,
              "output": 30,
              "cacheRead": 2.5,
              "cacheWrite": 0
            }
          }
        ]
      }
    }
  },
  "secrets": {
    "providers": {
      "gateway_env": {
        "source": "env",
        "allowlist": [
          "OPENCLAW_GATEWAY_TOKEN"
        ]
      },
      "deepseek_env": {
        "source": "env",
        "allowlist": [
          "DEEPSEEK_API_KEY"
        ]
      },
      "foursapi_anthropic_env": {
        "source": "env",
        "allowlist": [
          "FOURSAPI_ANTHROPIC_API_KEY"
        ]
      },
      "foursapi_openai_env": {
        "source": "env",
        "allowlist": [
          "FOURSAPI_OPENAI_API_KEY"
        ]
      }
    }
  },
  "auth": {
    "profiles": {
      "deepseek:default": {
        "provider": "deepseek",
        "mode": "api_key"
      }
    }
  },
  "skills": {
    "entries": {
      "1password": {
        "enabled": false
      },
      "apple-notes": {
        "enabled": false
      },
      "apple-reminders": {
        "enabled": false
      },
      "bear-notes": {
        "enabled": false
      },
      "blogwatcher": {
        "enabled": false
      },
      "blucli": {
        "enabled": false
      },
      "camsnap": {
        "enabled": false
      },
      "clawhub": {
        "enabled": true
      },
      "eightctl": {
        "enabled": false
      },
      "gemini": {
        "enabled": false
      },
      "gog": {
        "enabled": false
      },
      "goplaces": {
        "enabled": false
      },
      "healthcheck": {
        "enabled": true
      },
      "himalaya": {
        "enabled": false
      },
      "notion": {
        "enabled": false
      },
      "obsidian": {
        "enabled": false
      },
      "openai-whisper-api": {
        "enabled": false
      },
      "oracle": {
        "enabled": false
      },
      "openhue": {
        "enabled": false
      },
      "ordercli": {
        "enabled": false
      },
      "sag": {
        "enabled": false
      },
      "sherpa-onnx-tts": {
        "enabled": false
      },
      "spike": {
        "enabled": true
      },
      "spotify-player": {
        "enabled": false
      },
      "trello": {
        "enabled": false
      },
      "video-frames": {
        "enabled": false
      },
      "xurl": {
        "enabled": false
      },
      "songsee": {
        "enabled": false
      },
      "sonoscli": {
        "enabled": false
      },
      "openai-whisper": {
        "enabled": false
      },
      "peekaboo": {
        "enabled": false
      },
      "things-mac": {
        "enabled": false
      },
      "model-usage": {
        "enabled": false
      },
      "taskflow-inbox-triage": {
        "enabled": true
      },
      "weather": {
